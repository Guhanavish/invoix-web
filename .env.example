# Invoix web portal - environment variables
# Copy to .env.local for local development, or set in Vercel dashboard
# (Project -> Settings -> Environment Variables).

# REQUIRED - JWT signing secret for login sessions.
# Generate one: openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-long-random-string

# Google sign-in (optional - enables "Sign in with Google" on the website
# and in the desktop app). Get these from:
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# (Application type: Web application)
#
# Authorized JavaScript origins (add yours):
#   http://localhost:3000
#   https://<your-vercel-domain>.vercel.app
# Authorized redirect URIs (add yours):
#   http://localhost:3000
#   https://<your-vercel-domain>.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel only - created automatically when you add a Blob store in the
# Vercel dashboard (Storage -> Create -> Blob). Do NOT set this locally.
# BLOB_READ_WRITE_TOKEN=

# Email (SMTP) - used to send password-reset OTP emails.
# Gmail example: generate an App Password at
#   https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
# then set SMTP_USER to your Gmail address and SMTP_PASS to the 16-char app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Invoix <you@gmail.com>

# Optional overrides (local server only; Vercel ignores these)
# PORT=3000
# WEB_DIR=../web/dist
# DOWNLOADS_DIR=./downloads
